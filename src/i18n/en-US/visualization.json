  "descriptions": {
    "heatmap": {
      "desc": "Visualize gene expression matrices or correlation matrices",
      "tags": [
        "Clustered Heatmap",
        "Correlation Heatmap",
        "Differential Heatmap"
      ]
    },
    "volcano": {
      "desc": "Display statistical significance and fold change of differentially expressed genes",
      "tags": [
        "Gene Annotation",
        "Threshold Lines",
        "Multi-group Comparison"
      ]
    },
    "pca": {
      "desc": "Show sample similarities and differences via dimensionality reduction",
      "tags": [
        "Cluster Analysis",
        "Batch Effect",
        "Sample Grouping"
      ]
    },
    "venn": {
      "desc": "Show intersections and unions among multiple datasets",
      "tags": [
        "Proportional Venn",
        "UpSet Plot",
        "Intersection Analysis"
      ]
    },
    "line": {
      "desc": "Show data trends over time or conditions",
      "tags": [
        "Line Chart",
        "Area Chart",
        "Multi-series Comparison"
      ]
    },
    "bar": {
      "desc": "Compare numerical values between different groups",
      "tags": [
        "Grouped Bar",
        "Stacked Bar",
        "Error Bars"
      ]
    },
    "scatter": {
      "desc": "Show correlation between two variables",
      "tags": [
        "Correlation Analysis",
        "Regression Line",
        "Density Scatter"
      ]
    },
    "pie": {
      "desc": "Show proportional relationships of parts to the whole",
      "tags": [
        "Pie Chart",
        "Donut Chart",
        "Nightingale Chart"
      ]
    },
    "boxplot": {
      "desc": "Display data distribution with median, quartiles, and outliers",
      "tags": [
        "Box Plot",
        "Violin Plot",
        "Beeswarm Plot"
      ]
    },
    "violin": {
      "desc": "Show data distribution density and statistical features",
      "tags": [
        "Violin Plot",
        "Split Violin",
        "With Box Plot"
      ]
    },
    "bubble": {
      "desc": "Show relationships in 3D data where size represents an additional dimension",
      "tags": [
        "Bubble Chart",
        "Interactive",
        "Dynamic Display"
      ]
    },
    "radar": {
      "desc": "Display comprehensive performance across multiple dimensions",
      "tags": [
        "Radar Chart",
        "Spider Chart",
        "Capability Assessment"
      ]
    },
    "sankey": {
      "desc": "Show flow distribution and conversion between nodes",
      "tags": [
        "Sankey Diagram",
        "Flow Chart",
        "Conversion Analysis"
      ]
    },
    "survival": {
      "desc": "Time-to-event analysis of survival data",
      "tags": [
        "KM Curve",
        "Risk Table",
        "Group Comparison"
      ]
    },
    "roc": {
      "desc": "Evaluate classification model performance and cutoff selection",
      "tags": [
        "ROC Curve",
        "Multi-model Comparison",
        "AUC Calculation"
      ]
    },
    "waterfall": {
      "desc": "Show cumulative impact of changes on the total",
      "tags": [
        "Waterfall Chart",
        "Bridge Chart",
        "Financial Analysis"
      ]
    },
    "network": {
      "desc": "Display gene/protein interaction relationships",
      "tags": [
        "Network Graph",
        "Regulatory Network",
        "Interaction Analysis"
      ]
    },
    "manhattan": {
      "desc": "Show chromosome positioning results from GWAS",
      "tags": [
        "Manhattan Plot",
        "Significance Threshold",
        "Gene Annotation"
      ]
    },
    "qqplot": {
