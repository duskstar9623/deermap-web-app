{
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "files.associations": {
    "*.css": "css"
  },
  "css.lint.unknownAtRules": "ignore",
  "cSpell.words": [
    "bioinfo",
    "Bioinformatics",
    "multiomics"
  ]
}